---
import Monogram from './Monogram.astro';
import Marquee from './Marquee.astro';
import { BRAND } from '../data/site';
import { IMG, poolSq } from '../data/images';

const colA = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Services', href: '/services' },
];
const colB = [
  { label: 'Experience', href: '/experience' },
  { label: 'The Blog', href: '/blog-home' },
  { label: 'Inquire', href: '/contact' },
];
---

<footer class="bg-cream">
  <!-- Demo disclosure -->
  <p class="border-t border-hairline px-5 py-5 text-center text-[11px] uppercase tracking-[0.28em] text-body sm:px-8">
    Demo website — fictional content. Photography via Pexels.
  </p>

  <!-- Monogram + tagline / nav columns -->
  <div class="mx-auto grid max-w-[1600px] gap-10 px-5 py-12 sm:px-8 lg:grid-cols-[1.2fr_1fr_1fr] lg:py-16">
    <div data-reveal>
      <Monogram size="lg" />
      <p class="mt-6 max-w-sm text-[15px] leading-relaxed text-body">{BRAND.tagline}</p>
      <p class="mt-5 text-sm text-ink">
        <a class="u-link" href={`mailto:${BRAND.email}`}>{BRAND.email}</a>
        <span class="mx-2 text-stone2" aria-hidden="true">·</span>
        <a class="u-link" href={`tel:${BRAND.phone.replace(/[^+\d]/g, '')}`}>{BRAND.phone}</a>
      </p>
    </div>
    <nav aria-label="Footer" data-reveal>
      <ul class="space-y-3">
        {
          colA.map((l) => (
            <li>
              <a href={l.href} class="font-display text-2xl text-ink transition-opacity hover:opacity-60 lg:text-[28px]">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-label="Footer more" data-reveal>
      <ul class="space-y-3">
        {
          colB.map((l) => (
            <li>
              <a href={l.href} class="font-display text-2xl text-ink transition-opacity hover:opacity-60 lg:text-[28px]">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <!-- Giant cropped wordmark -->
  <div class="overflow-hidden" aria-hidden="true">
    <p class="mb-[-0.22em] whitespace-nowrap text-center font-display text-[13.2vw] font-medium leading-[0.85] tracking-[0.04em] text-ink">
      MAYA BENNETT
    </p>
  </div>

  <!-- Marquee band -->
  <div class="border-y border-hairline py-4">
    <Marquee
      segments={[
        { text: 'RESERVE YOUR DATE', href: '/contact' },
        { text: 'FOLLOW ALONG ON INSTAGRAM', href: BRAND.instagram },
        { text: 'FIND ME ON TIKTOK', href: BRAND.tiktok },
      ]}
      separator="/"
      repeat={2}
      segmentCls="px-5 text-[13px] font-medium tracking-[0.22em] text-ink hover:opacity-60"
      sepCls="px-1 text-body"
      label="Reserve your date, follow along on Instagram, find me on TikTok"
    />
  </div>

  <!-- Instagram grid -->
  <div class="mx-auto max-w-[1600px] px-5 py-10 sm:px-8">
    <p class="mb-5 text-center">
      <a href={BRAND.instagram} class="u-link text-[13px] font-medium uppercase tracking-[0.28em] text-ink">@mayabennettphoto</a>
    </p>
    <div class="grid grid-cols-3 gap-2 sm:grid-cols-4 lg:grid-cols-7">
      {
        IMG.instagram.map((n, i) => (
          <a
            href={BRAND.instagram}
            aria-label={`Maya Bennett on Instagram — photo ${i + 1}`}
            class="group block aspect-square overflow-hidden bg-panel"
          >
            <img
              src={poolSq(n)}
              alt=""
              width="600"
              height="600"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </a>
        ))
      }
    </div>
    <p class="mt-10 text-center text-xs text-body">© 2026 Maya Bennett Photography — Demo website. All stories, names and venues are fictional.</p>
  </div>
</footer>
