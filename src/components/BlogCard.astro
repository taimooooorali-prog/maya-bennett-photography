---
import Pic from './Pic.astro';
import type { Post } from '../data/site';

interface Props {
  post: Post;
  imgN: number;
  categoryLabel?: boolean;
}
const { post, imgN, categoryLabel = true } = Astro.props;
---

<article class="group" data-reveal>
  <a href={`/journal/${post.slug}`} class="block overflow-hidden bg-panel" aria-label={post.title} tabindex="-1">
    <div class="aspect-[4/3] overflow-hidden">
      <Pic n={imgN} alt="" sizes="(max-width: 768px) 90vw, 45vw" cls="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
    </div>
  </a>
  <div class="pt-5">
    {categoryLabel && <p class="eyebrow text-body">{post.category}</p>}
    <h3 class="mt-2 font-display text-[26px] leading-tight text-ink sm:text-3xl">
      <a href={`/journal/${post.slug}`} class="transition-opacity hover:opacity-70">{post.title}</a>
    </h3>
    <p class="mt-2 text-[15px] leading-relaxed text-body">{post.excerpt}</p>
    <p class="mt-4">
      <a href={`/journal/${post.slug}`} class="u-link text-[13px] font-medium uppercase tracking-[0.2em] text-ink">Read More</a>
    </p>
  </div>
</article>
