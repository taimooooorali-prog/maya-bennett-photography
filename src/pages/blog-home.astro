---
import BaseLayout from '../layouts/BaseLayout.astro';
import Pic from '../components/Pic.astro';
import BlogCard from '../components/BlogCard.astro';
import { POSTS } from '../data/site';
import { IMG } from '../data/images';

const featured = POSTS[0];
const rest = POSTS.slice(1);
---

<BaseLayout
  title="The Blog | Maya Bennett Photography"
  description="Notes on weddings, planning, film photography and real celebrations — from San Diego wedding photographer Maya Bennett."
  current="/blog-home"
>
  <!-- ============ HERO ============ -->
  <section class="mx-auto max-w-[1600px] px-5 pb-10 pt-10 text-center sm:px-8 lg:pt-16">
    <p class="eyebrow text-body" data-reveal>Notes &amp; Stories</p>
    <h1 class="mt-6 font-display text-[13vw] font-medium leading-[0.92] tracking-tight text-ink sm:text-7xl lg:text-[88px]" data-reveal>
      THE BLOG
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-[15px] leading-relaxed text-body" data-reveal>
      Honest advice, real weddings, and the occasional love letter to film — written between
      celebrations, usually with coffee in hand.
    </p>
  </section>

  <!-- ============ FEATURED POST ============ -->
  <section class="mx-auto max-w-[1600px] px-5 pb-16 sm:px-8">
    <a href={`/journal/${featured.slug}`} class="group grid items-center gap-8 lg:grid-cols-2 lg:gap-14" data-reveal>
      <div class="aspect-[4/3] overflow-hidden bg-panel">
        <Pic n={IMG.blogHeroes[0]} alt="" sizes="(max-width: 1024px) 90vw, 45vw" cls="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
      </div>
      <div>
        <p class="eyebrow text-body">{featured.category} — Featured</p>
        <h2 class="mt-3 font-display text-4xl font-medium leading-[1.02] tracking-tight text-ink sm:text-5xl">
          {featured.title}
        </h2>
        <p class="mt-4 max-w-lg text-[15px] leading-relaxed text-body">{featured.excerpt}</p>
        <p class="mt-6">
          <span class="u-link text-[13px] font-medium uppercase tracking-[0.2em] text-ink">Read the Story</span>
        </p>
      </div>
    </a>
  </section>

  <!-- ============ POST GRID ============ -->
  <section class="mx-auto max-w-[1600px] px-5 pb-16 sm:px-8 lg:pb-24" aria-label="More stories">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-12">
      {
        rest.map((post, i) => (
          <BlogCard post={post} imgN={IMG.blogHeroes[i + 1]} />
        ))
      }
    </div>
    <p class="mt-14 text-center" data-reveal>
      <a href="/journal" class="u-link text-[13px] font-medium uppercase tracking-[0.24em] text-ink">View All Stories</a>
    </p>
  </section>
</BaseLayout>
