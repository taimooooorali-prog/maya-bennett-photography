---
import BaseLayout from '../layouts/BaseLayout.astro';
import Pic from '../components/Pic.astro';
import Monogram from '../components/Monogram.astro';
import { TESTIMONIALS } from '../data/site';
import { IMG, pool } from '../data/images';
---

<BaseLayout
  title="About Maya Bennett | San Diego Wedding Photographer"
  description="Meet Maya Bennett — a San Diego wedding photographer with a decade behind the lens, shooting honest, sun-soaked celebrations on digital and film."
  current="/about"
>
  <!-- ============ CREAM HERO ============ -->
  <section class="mx-auto max-w-[1600px] px-5 pb-16 pt-10 text-center sm:px-8 lg:pt-16">
    <p class="eyebrow text-body" data-reveal>About Maya</p>
    <h1 class="mx-auto mt-6 max-w-5xl font-display text-[11vw] font-medium leading-[0.95] tracking-tight text-ink sm:text-7xl lg:text-[88px]" data-reveal>
      THE WOMAN BEHIND<br /><em class="font-normal">the</em> LENS
    </h1>
    <div class="mx-auto mt-12 aspect-[16/9] max-w-4xl overflow-hidden bg-panel" data-reveal>
      <Pic n={IMG.aboutHero} alt="Three gold wedding rings lined up on a green leaf, black and white" sizes="(max-width: 768px) 90vw, 60vw" bw cls="h-full w-full object-cover" />
    </div>
    <div class="mx-auto mt-12 max-w-2xl space-y-5 text-left sm:text-center" data-reveal>
      <p class="text-[15px] leading-relaxed text-body">
        I picked up my first film camera at fourteen and never really put it down. What started as
        photographs of my sisters in our backyard became a decade of weddings — three hundred
        celebrations, a thousand happy tears, and a career built on one simple idea: the most
        beautiful photographs are the honest ones.
      </p>
      <p class="text-[15px] leading-relaxed text-body">
        My approach is quiet and watchful. I will direct you gently when a moment needs shaping,
        and step back the rest of the time, so your day unfolds naturally and your gallery feels
        like memory — warm, a little wild, and completely yours.
      </p>
    </div>
  </section>

  <!-- ============ TWO TESTIMONIALS ============ -->
  <section class="mx-auto max-w-[1600px] px-5 pb-16 sm:px-8 lg:pb-24" aria-label="Kind words">
    <div class="grid gap-10 md:grid-cols-2 lg:gap-16">
      {
        TESTIMONIALS.slice(6, 8).map((t) => (
          <figure class="border-t border-hairline pt-8 text-center" data-reveal>
            <blockquote>
              <p class="mx-auto max-w-md font-display text-2xl italic leading-snug text-ink">“{t.quote}”</p>
            </blockquote>
            <figcaption class="mt-5">
              <span class="eyebrow text-body">Kind words from&nbsp;</span>
              <span class="eyebrow text-ink">{t.names.toUpperCase()}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <!-- ============ OLIVE BEHIND THE LENS BAND ============ -->
  <section class="bg-olive text-cream">
    <div class="mx-auto max-w-[1600px] px-5 py-16 sm:px-8 lg:py-20">
      <div class="flex flex-col items-end text-right" data-reveal>
        <Monogram size="lg" cls="text-cream" />
        <p class="eyebrow mt-6 text-cream/80">Behind the Lens</p>
        <h2 class="mt-4 max-w-2xl font-display text-4xl font-medium leading-[1.02] tracking-tight sm:text-5xl lg:text-[56px]">
          Film in one hand,<br />sunshine in the other
        </h2>
        <p class="mt-6 max-w-xl text-[15px] leading-relaxed text-cream/85">
          I shoot every wedding with both digital and 35mm film cameras. Digital keeps the record
          complete and reliable; film keeps it feeling. The combination is the heart of my work —
          sharp where it matters, soft where it counts.
        </p>
      </div>
      <div class="mt-12 aspect-[16/8] overflow-hidden" data-reveal>
        <Pic n={IMG.aboutBehind} alt="Maya Bennett photographing with a film camera" sizes="90vw" cls="h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- ============ FULL-BLEED PHOTO + OVERLAID QUOTE ============ -->
  <section class="relative" aria-label="Featured testimonial">
    <div class="relative h-[70svh] min-h-[480px] overflow-hidden">
      <Pic n={IMG.aboutFullbleed} alt="Bride and groom smiling at each other against fairy lights" sizes="100vw" cls="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-black/25" aria-hidden="true"></div>
      <figure class="absolute inset-0 flex flex-col items-center justify-center px-5 text-center text-white" data-reveal>
        <blockquote>
          <p class="max-w-3xl font-display text-[28px] italic leading-snug sm:text-4xl">
            “Maya asked about our story before she asked about our timeline, and it shows.”
          </p>
        </blockquote>
        <figcaption class="mt-6">
          <span class="eyebrow text-white/80">Kind words from&nbsp;</span>
          <span class="eyebrow text-white">NORA &amp; OLIVER</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ GIANT SPLIT HEADLINE ============ -->
  <section class="mx-auto max-w-[1600px] px-5 py-20 text-center sm:px-8 lg:py-28">
    <h2 class="font-display text-[11vw] font-medium leading-[0.95] tracking-tight text-ink sm:text-7xl lg:text-[88px]" data-reveal>
      KIND EYES,<br />QUICK FEET,<br /><em class="font-normal">honest</em> FILM
    </h2>
  </section>

  <!-- ============ TWO CARDS ============ -->
  <section class="mx-auto max-w-[1600px] px-5 pb-20 sm:px-8 lg:pb-28" aria-label="Continue exploring">
    <div class="grid gap-4 sm:grid-cols-2">
      <a href="/portfolio" class="group relative block aspect-[4/3] overflow-hidden bg-panel" data-reveal>
        <Pic n={IMG.aboutCard1} alt="Bride in profile in a lace gown, lit by a round halo of light" sizes="(max-width: 640px) 90vw, 45vw" cls="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" />
        <span class="absolute inset-x-0 bottom-0 flex items-center justify-between bg-cream/90 px-5 py-4">
          <span class="font-display text-2xl text-ink">Explore the Portfolio</span>
          <span class="u-link text-[12px] font-medium uppercase tracking-[0.2em] text-ink">View</span>
        </span>
      </a>
      <a href="/experience" class="group relative block aspect-[4/3] overflow-hidden bg-panel" data-reveal>
        <Pic n={IMG.aboutCard2} alt="Seaside reception with a long table, white chairs and tall candles" sizes="(max-width: 640px) 90vw, 45vw" cls="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" />
        <span class="absolute inset-x-0 bottom-0 flex items-center justify-between bg-cream/90 px-5 py-4">
          <span class="font-display text-2xl text-ink">Discover the Experience</span>
          <span class="u-link text-[12px] font-medium uppercase tracking-[0.2em] text-ink">View</span>
        </span>
      </a>
    </div>
  </section>
</BaseLayout>
