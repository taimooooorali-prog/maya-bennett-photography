---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pic from '../../components/Pic.astro';
import { POSTS } from '../../data/site';
import { IMG } from '../../data/images';

export async function getStaticPaths() {
  return POSTS.map((post, i) => ({ params: { slug: post.slug }, props: { post, index: i } }));
}

const { post, index } = Astro.props;
const heroN = IMG.blogHeroes[index];
const [inlineA, inlineB] = IMG.blogInline[index];
---

<BaseLayout
  title={`${post.title} | Maya Bennett Photography`}
  description={post.excerpt}
  current="/journal"
  ogImage={IMG ? `/images/pool/pool-${String(heroN).padStart(2, '0')}.webp` : undefined}
>
  <article class="mx-auto max-w-[1600px] px-5 pb-20 pt-10 sm:px-8 lg:pt-14">
    <header class="mx-auto max-w-3xl text-center">
      <p class="eyebrow text-body" data-reveal>
        {post.category} <span class="mx-1 normal-case tracking-normal">·</span> {post.date}
      </p>
      <h1 class="mt-5 font-display text-4xl font-medium leading-[1.02] tracking-tight text-ink sm:text-5xl lg:text-[56px]" data-reveal>
        {post.title}
      </h1>
      <p class="mt-5 text-[15px] leading-relaxed text-body" data-reveal>By Maya Bennett — {post.category}</p>
    </header>

    <div class="mx-auto mt-10 aspect-[16/9] max-w-4xl overflow-hidden bg-panel" data-reveal>
      <Pic n={heroN} alt="" sizes="(max-width: 768px) 90vw, 60vw" eager cls="h-full w-full object-cover" />
    </div>

    <div class="mx-auto mt-12 max-w-2xl" data-reveal>
      <p class="text-[16px] leading-[1.85] text-ink">{post.paragraphs[0]}</p>
      <p class="mt-6 text-[16px] leading-[1.85] text-ink">{post.paragraphs[1]}</p>
    </div>

    <div class="mx-auto mt-10 aspect-[4/3] max-w-2xl overflow-hidden bg-panel" data-reveal>
      <Pic n={inlineA} alt="" sizes="(max-width: 768px) 90vw, 40vw" cls="h-full w-full object-cover" />
    </div>

    <div class="mx-auto mt-12 max-w-2xl" data-reveal>
      <blockquote class="border-l-2 border-olive pl-6">
        <p class="font-display text-[26px] italic leading-snug text-ink">“{post.pullQuote}”</p>
      </blockquote>
      <p class="mt-8 text-[16px] leading-[1.85] text-ink">{post.paragraphs[2]}</p>
    </div>

    <div class="mx-auto mt-10 aspect-[4/3] max-w-2xl overflow-hidden bg-panel" data-reveal>
      <Pic n={inlineB} alt="" sizes="(max-width: 768px) 90vw, 40vw" cls="h-full w-full object-cover" />
    </div>

    <div class="mx-auto mt-12 max-w-2xl" data-reveal>
      <p class="text-[16px] leading-[1.85] text-ink">{post.paragraphs[3]}</p>
      <p class="mt-10 flex flex-wrap gap-x-8 gap-y-3">
        <a href="/journal" class="u-link text-[13px] font-medium uppercase tracking-[0.2em] text-ink">Back to the Journal</a>
        <a href="/contact" class="u-link u-link-serif text-xl text-ink">Inquire</a>
      </p>
    </div>
  </article>
</BaseLayout>
